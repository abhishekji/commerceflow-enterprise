{
  "name": "commerceflow-enterprise",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "bootstrap:tenant-admin": "tsx apps/api/src/scripts/bootstrap-tenant-admin.ts",
    "build": "tsc",
    "build:web": "vite build",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "test:web": "vitest run --config vite.config.mjs",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "format": "prettier --write .",
    "test:api": "vitest run --config vitest.api.config.mjs",
    "test:api:coverage": "vitest run --coverage --config vitest.api.config.mjs",
    "test:web:coverage": "vitest run --coverage --config vite.config.mjs",
    "test": "npm run test:api && npm run test:web",
    "test:coverage": "npm run test:api:coverage && npm run test:web:coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/client-sqs": "^3.1154.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
