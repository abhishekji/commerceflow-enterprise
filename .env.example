NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/commerceflow?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
# Swagger UI at /api-docs. Defaults to true outside production; set true to expose it in production.
SWAGGER_ENABLED=true
# Optional: enables the AI assistant (/api/v1/ai/*). Without it those endpoints return 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
