# FRONTEND server: copy to /opt/commerceflow-frontend/.env (chmod 600). Never commit the real file.
WEB_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/commerceflow-web:latest

# VPC private IP of the backend server (not the public IP)
BACKEND_PRIVATE_IP=10.0.2.10

# Public hostname with DNS A record -> frontend Elastic IP. Use ":80" for plain HTTP without a domain.
DOMAIN=app.example.com
