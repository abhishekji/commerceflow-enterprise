# BACKEND server: copy to /opt/commerceflow-backend/.env (chmod 600). Never commit the real file.
API_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/commerceflow-api:latest

# Must exactly match the browser origin served by the frontend server (https://DOMAIN)
WEB_ORIGIN=https://app.example.com

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SWAGGER_ENABLED=false
AWS_REGION=ap-south-1
# Optional: enables the AI assistant. Leave empty to keep it disabled (endpoints return 503).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
