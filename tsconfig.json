{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "apps/api/src",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["apps/api/src/**/*.ts"]
}
